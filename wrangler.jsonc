// Cloudflare Workers config: serves the static export in out/. The only server code is
// worker/index.ts, which redirects "/" to /pl/ or /en/ by the browser's language.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ziecina-dev",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.ts",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/"],
    "directory": "./out",
    // Unknown URLs get out/404.html with a 404 status.
    "not_found_handling": "404-page",
    // /en -> /en/, matching trailingSlash in next.config.ts.
    "html_handling": "force-trailing-slash"
  }
}
